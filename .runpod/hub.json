{
  "title": "waifu2x",
  "description": "Image Super-Resolution for Anime-Style Art on Runpod!",
  "type": "serverless",
  "category": "image",
  "iconUrl": "https://raw.githubusercontent.com/LarveyOfficial/waifu2x-runpod/refs/heads/main/.runpod/waifu2x.jpg",

  "config": {
    "runsOn": "GPU",
    "containerDiskInGb": 20,

    "gpuCount": 1,
    "gpuIds": "AMPERE_16, AMPERE_24, ADA_24",

    "env": [
      {
        "key": "RUNTIME",
        "value": "nvidia"
      },
      {
        "key": "GPUS",
        "value": "all"
      }
    ]
  }
}
